# =============================================================================
# URA Chatbot - Git Ignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ML Artifacts (generated, not tracked)
artifacts/
mlruns/

# Model files (large, use DVC or HF Hub)
Model/*.joblib
Model/*.pth
Model/*.pt
Model/*.onnx
Model/*.tflite
Model/faiss_index/

# Results (regenerated)
Results/metrics/*.json
Results/plots/*.png
Results/plots/*.pdf
Results/reports/*.json
Results/reports/*.csv

# Node.js
node_modules/
.npm
.pnp
.pnp.js

# Next.js
frontend/.next/
frontend/out/

# Vercel
.vercel

# Docker
*.log

# OS
.DS_Store
Thumbs.db

# Kaggle
ml/kaggle/*.ipynb
ml/kaggle/kernel-metadata.json

# Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key
kaggle.json

# Test artifacts
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# Temporary
tmp/
temp/
*.tmp
ci-ml-pipeline.yml
