# =============================================================================
# URA Chatbot - Git Ignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Frozen LLM prompt contexts generated during model bake-offs
App/evals/complex_scenarios/frozen_contexts_*.jsonl

# Virtual environments
.env
.venv
env/
venv/
ENV/
test_env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ML Artifacts (generated, not tracked)
artifacts/
mlruns/

# App/Model tracks three files. The rest is downloads (LLM checkpoints such as
# App/Model/Sunflower-14B-FP8/, re-fetched via LLM_MODEL in App/.env.example),
# weight files, and index runtime state (index_*.json, static_index.npz).
App/Model/*
!App/Model/.gitkeep
!App/Model/README.md
!App/Model/bm25_state.json

# On-device LLM weights (too large for Git, distribute via release/HF Hub)
*.gguf

# Results (regenerated)
# Lowercase runtime output dir the load harness and its CI job create with
# `--out results/...`. Committed measurements live in App/Results/load/ instead —
# a tracked lowercase `results/` collides with `App/Results/` on macOS/Windows and
# trips pre-commit's check-case-conflict.
/results/
App/Results/metrics/*.json
App/Results/plots/*.png
App/Results/plots/*.pdf
App/Results/reports/*.json
App/Results/reports/*.csv
# Corpus-coverage run reports (#303) — measurements, not artefacts to review;
# the gate reads floors from App/Data/eval/coverage_domains.yaml, not from these.
App/Results/eval/*.json
App/Results/load/*volume*.json

# Node.js
node_modules/
.npm
.pnp
.pnp.js

# Next.js
frontend/.next/
frontend/out/

# Docker
*.log

# OS
.DS_Store
Thumbs.db

# Kaggle
App/ml/kaggle/*.ipynb
ml/kaggle/kernel-metadata.json

# Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key
kaggle.json

# Secret scanning tool caches & reports
.ggshield_cache/
gitleaks-report.json
gitleaks-report.sarif

# Threat model generated output
threat-model/output/

# Test artifacts
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# Temporary
tmp/
temp/
*.tmp
ci-ml-pipeline.yml
# Agent and assistant files at the repository root stay on the machine that
# uses them. The repository's own guide for agents is App/AGENTS.md, with a
# nested guide beside each package (ADR-0064 phase F).
/AGENTS.md
/CLAUDE.md
/GEMINI.md
.claude/
.cursor/
.codex/
.gemini/
.windsurf/
App/Data/common_voice_*

# Runtime analytics databases (conversation logs — privacy: never commit).
# Created by the backend and by pytest runs at the repo root and App/backend.
data_store/

# Vendored CosyVoice checkout. It was once committed as a gitlink with no
# .gitmodules entry, which made `actions/checkout` fail outright ("No url
# found for submodule path 'CosyVoice'") and took every browser E2E job with
# it. Ignored so a local clone here cannot be staged again.
CosyVoice/
missfont.log
.antigravitycli/
.agents/

# Local evaluation checkpoints and logs
App/docs/Reports/data/*_checkpoint.json
App/docs/Reports/data/*.log

# Retired Flutter mobile build artifacts & Dart tool caches
MobileApp/
.dart_tool/
.flutter-plugins*
