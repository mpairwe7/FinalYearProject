# Standalone Dockerfile for URA Enterprise Systems & MCP Gateway
FROM python:3.14.8-slim-bookworm@sha256:44e000a07b48bef1517a2b14adc93c17af728ca98858b5e24c6e1b18de1b2ef2

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8200

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Install minimal server requirements matching backend stack (cp314 wheels)
RUN pip install --no-cache-dir \
    "fastapi>=0.141.1,<0.142" \
    "uvicorn>=0.52.4,<0.53" \
    "pydantic>=2.13.5,<2.14"

# Create non-root user
RUN groupadd --gid 10001 appuser && \
    useradd --uid 10001 --gid appuser --create-home --shell /usr/sbin/nologin appuser

# Copy plugins package and create data_store volume directory
COPY --chown=appuser:appuser plugins/ /app/plugins/
RUN mkdir -p /app/data_store && chown -R appuser:appuser /app

USER appuser

EXPOSE 8200

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8200/health || exit 1

CMD ["uvicorn", "plugins.server:app", "--host", "0.0.0.0", "--port", "8200"]
