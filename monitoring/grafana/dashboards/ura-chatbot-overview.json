{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 7,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(ura_http_requests_total[5m])",
          "legendFormat": "{{ method }} {{ path }}"
        }
      ]
    },
    {
      "title": "Error Rate (%)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "rate(ura_http_errors_total[5m]) / rate(ura_http_requests_total[5m]) * 100",
          "legendFormat": "error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "title": "Chat p95 Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(ura_chat_response_time_ms_bucket{path=\"/v1/chat\"}[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, rate(ura_chat_response_time_ms_bucket{path=\"/v1/chat\"}[5m]))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Faithfulness Score Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "ura_faithfulness_score",
          "legendFormat": "faithfulness"
        }
      ]
    },
    {
      "title": "Escalation Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(ura_escalation_total[5m])",
          "legendFormat": "escalations/s"
        }
      ]
    },
    {
      "title": "Retrieval Mode Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (mode) (ura_retrieval_mode_total)",
          "legendFormat": "{{ mode }}"
        }
      ]
    },
    {
      "title": "Feedback (Thumbs Up / Down)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "rate(ura_feedback_total{rating=\"up\"}[1h])",
          "legendFormat": "thumbs up"
        },
        {
          "expr": "rate(ura_feedback_total{rating=\"down\"}[1h])",
          "legendFormat": "thumbs down"
        }
      ]
    },
    {
      "title": "Active Tickets by Status",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "sum by (status) (ura_tickets_active)",
          "legendFormat": "{{ status }}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["ura-chatbot", "mlops", "2026"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "Africa/Kampala",
  "title": "URA Chatbot — Production Overview",
  "uid": "ura-chatbot-overview",
  "version": 1,
  "weekStart": "monday"
}
