# =============================================================================
# URA Chatbot - Environment Variables Template
# Copy this to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
PORT=8887
WORKERS=2

# -----------------------------------------------------------------------------
# Hugging Face Hub
# Get token from: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HF_TOKEN=hf_your_token_here
HF_MODEL_REPO=mpairweLandwind/ura-chatbot

# -----------------------------------------------------------------------------
# Kaggle API
# Get credentials from: https://www.kaggle.com/account
# Download kaggle.json and extract values
# -----------------------------------------------------------------------------
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=your_kaggle_api_key

# -----------------------------------------------------------------------------
# Docker Hub
# -----------------------------------------------------------------------------
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token
DOCKER_IMAGE=landwind/ura-chatbot-api

# -----------------------------------------------------------------------------
# Frontend Docker Image
# -----------------------------------------------------------------------------
DOCKER_IMAGE_FRONTEND=landwind/ura-chatbot-frontend

# -----------------------------------------------------------------------------
# Data & Indexing
# -----------------------------------------------------------------------------
DATA_DIR=Data/dataset
PDF_DIR=Data/pdfs
ANALYTICS_DB_DIR=data_store
CHUNK_SIZE=800
CHUNK_OVERLAP=120
INDEX_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# API URLs & CORS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8887
PRODUCTION_API_URL=https://your-api-domain.com
CORS_ORIGINS=http://localhost:3300

# -----------------------------------------------------------------------------
# Qdrant Vector Store (Hybrid Retrieval)
# See docs/MODEL_SWAP_GUIDE.md for tested alternatives.
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ura_knowledge_base
# Embeddings: BAAI/bge-m3 (1024d) or Qwen/Qwen3-Embedding-8B (MTEB 70.58)
DENSE_MODEL=BAAI/bge-m3
DENSE_DIM=1024
# Reranker: mxbai-rerank-base-v2 (BEIR 55.6) or BAAI/bge-reranker-v2-m3
RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v2
RERANK_ENABLED=true
GROUNDING_THRESHOLD=0.3
# Relevance floor used to decide whether to answer at all when NO cross-encoder
# score is available — the in-image Qdrant sidecar (sparse-only) has no reranker.
# It is the share of the question's IDF-weighted content words present in the best
# passage. Without it, BM25's always-something result over 7,000+ document chunks
# gets served for off-domain questions. Calibrated at 0.50 against the live corpus:
# on-domain scored 0.557-1.000, off-domain 0.000-0.406. Raise it to abstain more
# readily; lower it only with a measurement. See docs/CLOUDFLARE_FALLBACKS.md.
RETRIEVER_LEXICAL_FLOOR=0.50

# -----------------------------------------------------------------------------
# Contradiction grounding (app/entailment.py)
# -----------------------------------------------------------------------------
# Without this the claim checker runs its numeric-only fallback, which catches
# a wrong rate ("VAT is 20%" against an 18% passage) but is blind to semantic
# reversals — "registration is optional" against a passage saying compulsory,
# or "filed annually" against "filed monthly". Both are high-stakes here, so
# the NLI cross-encoder is on by default rather than an unset opt-in.
# Must be a 3-way NLI model whose labels are [contradiction, entailment,
# neutral]; the scorer reads index 0 as contradiction.
ENTAILMENT_MODEL=cross-encoder/nli-deberta-v3-small
# Minimum contradiction probability before a claim is treated as conflicting.
ENTAILMENT_CONTRADICTION_MIN=0.6

# -----------------------------------------------------------------------------
# LLM Configuration
# See docs/MODEL_SWAP_GUIDE.md for tested alternatives.
# Default: Qwen3-8B (Apache-2.0, MMLU 74.7, 128K context)
# Budget:  Qwen3-30B-A3B (MoE, 3B active, 30B quality)
# Legacy:  Qwen/Qwen2.5-3B-Instruct (smaller, 6144 context)
# -----------------------------------------------------------------------------
LLM_MODEL=Qwen/Qwen3-8B
LLM_CONTEXT_WINDOW=8192
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_ENABLED=true
LLM_DEVICE=auto
LLM_TORCH_DTYPE=auto

# -----------------------------------------------------------------------------
# LLM Backend (local HF Transformers or vLLM OpenAI-compatible)
# Set LLM_BACKEND=vllm and point VLLM_BASE_URL at your vLLM server.
# -----------------------------------------------------------------------------
LLM_BACKEND=local
VLLM_BASE_URL=http://localhost:8011/v1
VLLM_API_KEY=not-needed
VLLM_HTTP_TIMEOUT=60

# -----------------------------------------------------------------------------
# Feature Flags (FLAG_* env vars override registry defaults in flags.py)
# -----------------------------------------------------------------------------
FLAG_TOOL_USE=true
FLAG_AGENTIC_MODE=true
# FLAG_TICKET_QUEUE=false
# FLAG_WORKFLOWS=false
# FLAG_LANGGRAPH=false

# -- Phase 30: next-generation architecture (all default off) -----------------
# Open in this order; each has a gate to clear first. See
# docs/NEXTGEN_ARCHITECTURE_PROPOSAL_2026.md §7.2.
#
# Locale-specific supervisor patterns. Off, a Luganda query classifies
# against the English tables exactly as before.  Gate: lg golden set >= 90%
# (currently 23/23) and English still 36/36.
# FLAG_MULTILINGUAL_ROUTING=false
#
# Small-model second opinion when rule confidence is low.
# FLAG_SUPERVISOR_LLM_TIEBREAK=false
#
# Per-turn model tier from the route decision. Off, every turn uses
# LLM_MODEL, as before.  Gate: blended cost <= 1.2x baseline.
# FLAG_MODEL_TIERING=false
#
# Deterministic recomputation of money answers; a confirmed mismatch
# escalates.  Gate: numeric error rate down, p95 +<800ms.
# FLAG_EVALUATOR_OPTIMIZER=false
#
# Statutory knowledge graph. `tax_graph` loads it read-only; `graph_fusion`
# lets it reach an answer. Open fusion only if shadow precision >= 75%.
# FLAG_TAX_GRAPH=false
# FLAG_GRAPH_FUSION=false
#
# `tasks` MCP namespace for long-running work.
# FLAG_MCP_TASKS=false

# -- Addressable rollout ------------------------------------------------------
# Any flag can target a share of subjects instead of everyone. Bucketing is
# stable per (flag, subject), so a user stays on one side of the split, and
# widening the percentage never drops someone already inside it.
# A subject the rollout does not target falls through to the flag's DEFAULT,
# not to off — so adding a rollout cannot silently disable a default-on flag.
#
# FLAG_MODEL_TIERING_PERCENT=5           # 0-100, one decimal place
# FLAG_TAX_GRAPH_COHORTS=ura_staff,internal
# FLAG_TAX_GRAPH_ALLOWLIST=tin-1001,tin-1002

# -----------------------------------------------------------------------------
# Model tiers (used when FLAG_MODEL_TIERING=true)
# -----------------------------------------------------------------------------
# T1 stays the dense 8B and is PINNED for the locales below: the lg/sw/nyn/ach
# LoRA adapters are trained against this base, so promoting one of those turns
# to a MoE would drop the adapter and answer worse than the tier it left.
# MODEL_T1=Qwen/Qwen3-8B
# MODEL_T2=Qwen/Qwen3-30B-A3B-Instruct-2507
# MODEL_T3=Qwen/Qwen3-235B-A22B-Instruct-2507
# ADAPTER_BOUND_LOCALES=lg,sw,nyn,ach

# -----------------------------------------------------------------------------
# OpenTelemetry GenAI Observability (opt-in)
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ura-chatbot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# OWASP LLM Guardrails
# -----------------------------------------------------------------------------
MAX_INPUT_LENGTH=2000
ABSTENTION_THRESHOLD=0.15
ESCALATION_THRESHOLD=0.25
INDEX_API_KEY=

# -----------------------------------------------------------------------------
# Privacy & Data Retention
# -----------------------------------------------------------------------------
STORE_RAW_PROMPTS=false
CONVERSATION_TTL_DAYS=7
ANALYTICS_TTL_DAYS=365
FEEDBACK_TTL_DAYS=90
SESSION_TTL_DAYS=30

# -----------------------------------------------------------------------------
# MLflow Tracking (Optional)
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=ura-chatbot

# -----------------------------------------------------------------------------
# Production Timeouts & Resilience
# -----------------------------------------------------------------------------
LLM_INFERENCE_TIMEOUT=60
QDRANT_TIMEOUT=30
REQUEST_TIMEOUT=120
GRACEFUL_SHUTDOWN_TIMEOUT=10

# -----------------------------------------------------------------------------
# Deployment (Optional)
# SSH key for server deployment
# -----------------------------------------------------------------------------
# DEPLOY_KEY=path/to/ssh/key
# API_HOST=your-server.com

# =============================================================================
# Cloudflare free-tier + Gemini fallbacks  (graceful degradation on Crane Cloud)
# -----------------------------------------------------------------------------
# Master switch. When true, fallbacks fire ONLY if the primary is down or
# over-budget; otherwise behaviour is unchanged. All keys below are read via
# pydantic SecretStr and are never logged. Leave blank to disable a provider.
# =============================================================================
FLAG_CLOUDFLARE_FALLBACK=false

# Per-component selectors (only consulted when FLAG_CLOUDFLARE_FALLBACK=true)
#   DENSE_FALLBACK_BACKEND              -> retrieval fallback when Qdrant is unreachable.
#       unset (default) = AUTO: used whenever CLOUDFLARE_* + VECTORIZE_INDEX are set
#       workers_ai                      = force on (dense bge-m3 + Vectorize, no GPU)
#       none|off|disabled               = force off (degrade straight to keyword)
#     Retrieval always prefers Qdrant (dense + BM25 + rerank); this is tier 2, and
#     the index must be seeded first: python scripts/reindex_vectorize.py --create
#   LLM_FALLBACK_BACKEND=gemini|workers_ai
#   TRANSLATE_FALLBACK_BACKEND=gemini   -> Luganda via Gemini 2.5 Flash
#   STT_FALLBACK_BACKEND=workers_ai     -> Whisper on Workers AI
#   TTS_FALLBACK_BACKEND=workers_ai     -> Deepgram Aura-2 / MeloTTS on Workers AI
#
# STT_/TTS_FALLBACK_BACKEND are the English speech pipeline: Sunbird has no
# English voice, so English otherwise lands on edge-tts for TTS and Sunbird for
# ASR. Both stages are English-only and sit ahead of those in the chain.
#
# Do NOT enable these on the HF Space. Its free tier cannot reach Cloudflare —
# every call dies in the TLS handshake with "SSL: UNEXPECTED_EOF_WHILE_READING"
# (see relay_client.py, which exists for exactly this). The chain then tries
# both TTS models and waits out both timeouts before falling through: measured
# there, uncached English TTS went from ~0.3s to 32.6s. Enable only where
# egress to Cloudflare is confirmed working.
DENSE_FALLBACK_BACKEND=
LLM_FALLBACK_BACKEND=
TRANSLATE_FALLBACK_BACKEND=
STT_FALLBACK_BACKEND=
TTS_FALLBACK_BACKEND=

# Speech models used when the two selectors above are set to workers_ai.
# @cf/openai/whisper (without -turbo) returns 400 on this gateway.
# Aura-2 is first for payload size: ~21 KB of MP3 against MeloTTS's ~288 KB of
# WAV for the same sentence, which dominates on a mobile connection.
STT_FALLBACK_MODEL=@cf/openai/whisper-large-v3-turbo
TTS_FALLBACK_MODEL=@cf/deepgram/aura-2-en
TTS_FALLBACK_MODEL_2=@cf/myshell-ai/melotts

# Cloudflare account + API token — dash.cloudflare.com > My Profile > API Tokens
# Token scopes: Workers AI (Read), Vectorize (Edit), R2 (Edit), AI Gateway (Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare AI Gateway — AI > AI Gateway > create gateway (enable caching + rate-limit)
# CF_AIG_GATEWAY = gateway slug (path segment); CF_AIG_TOKEN = the gateway's auth token
CF_AIG_GATEWAY=
CF_AIG_TOKEN=

# Cloudflare Vectorize — wrangler vectorize create ura-kb-bge-m3 --dimensions 1024 --metric cosine
VECTORIZE_INDEX=ura-kb-bge-m3

# Cloudflare R2 (S3-compatible) — stores bm25_state.json, offline bundles, TTS audio cache
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ura-chatbot

# Google Gemini — key from https://aistudio.google.com/apikey (sent via x-goog-api-key header)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free-tier guardrails (usage silently degrades to the next tier when exceeded)
CF_NEURON_DAILY_BUDGET=10000
GEMINI_RPM=10

# -----------------------------------------------------------------------------
# Crane Cloud deploy — auto-refresh the access token via email/password login
# (mirrors the CRANE_CLOUD_* GitHub Actions secrets). APP_ID + API are not
# secret; EMAIL/PASSWORD are — keep filled values only in the gitignored .env.
# -----------------------------------------------------------------------------
CRANE_CLOUD_API=https://api.cranecloud.io
CRANE_CLOUD_APP_ID=b01219c6-9555-41e2-84c3-f15d764fb938
CRANE_CLOUD_EMAIL=
CRANE_CLOUD_PASSWORD=

# DNS-over-HTTPS resolver (app/doh_resolver.py). Set true on Crane Cloud / RENU
# where the pod has no working upstream DNS — resolves external hostnames via
# 1.1.1.1 over TCP/443 so the Cloudflare fallback + external LLM work. Leave
# false locally (system DNS is fine). Ported from AgriLinkUganda's workaround.
USE_DOH=false
