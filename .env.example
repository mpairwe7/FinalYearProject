# =============================================================================
# URA Chatbot - Environment Variables Template
# Copy this to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
PORT=8887
WORKERS=2

# -----------------------------------------------------------------------------
# Hugging Face Hub
# Get token from: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HF_TOKEN=hf_your_token_here
HF_MODEL_REPO=mpairweLandwind/ura-chatbot

# -----------------------------------------------------------------------------
# Kaggle API
# Get credentials from: https://www.kaggle.com/account
# Download kaggle.json and extract values
# -----------------------------------------------------------------------------
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=your_kaggle_api_key

# -----------------------------------------------------------------------------
# Docker Hub
# -----------------------------------------------------------------------------
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token
DOCKER_IMAGE=landwind/ura-chatbot-api

# -----------------------------------------------------------------------------
# Frontend Docker Image
# -----------------------------------------------------------------------------
DOCKER_IMAGE_FRONTEND=landwind/ura-chatbot-frontend

# -----------------------------------------------------------------------------
# Data & Indexing
# -----------------------------------------------------------------------------
DATA_DIR=Data/dataset
PDF_DIR=Data/pdfs
ANALYTICS_DB_DIR=data_store
CHUNK_SIZE=800
CHUNK_OVERLAP=120
INDEX_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# API URLs & CORS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8887

# Canonical public origin. Next resolves OpenGraph images and canonical links
# against this; without an absolute URL every social crawler drops the share
# card's image. Defaults to the Hugging Face Space when unset.
NEXT_PUBLIC_SITE_URL=https://landwind22-ura-chatbot.hf.space
PRODUCTION_API_URL=https://your-api-domain.com
CORS_ORIGINS=http://localhost:3300
# Comma-separated IPs/CIDRs of trusted reverse proxies for X-Forwarded-For
# validation (rate-limit IP spoofing mitigation). Defaults to loopback.
# TRUSTED_PROXY_HOSTS=127.0.0.1,::1

# -----------------------------------------------------------------------------
# Qdrant Vector Store (Hybrid Retrieval)
# See docs/MODEL_SWAP_GUIDE.md for tested alternatives.
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ura_knowledge_base
# For the safe staged rebuild (`python -m app.index_lifecycle --rebuild`), use
# a stable alias such as `ura_knowledge_base_active`. Do not reuse the name of
# an existing physical collection: aliases and collections cannot share a name.
# QDRANT_COLLECTION=ura_knowledge_base_active
# The candidate must retrieve each deterministic canary before its alias can
# be promoted. Keep the default 100% floor unless a measured evaluation set
# justifies another value.
# INDEX_CANARY_COUNT=3
# INDEX_CANARY_TOP_K=5
# INDEX_CANARY_MIN_HIT_RATE=1.0
# Embeddings: BAAI/bge-m3 (1024d) or Qwen/Qwen3-Embedding-8B (MTEB 70.58)
DENSE_MODEL=BAAI/bge-m3
DENSE_DIM=1024
# Reranker: mxbai-rerank-base-v2 (BEIR 55.6) or BAAI/bge-reranker-v2-m3
RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v2
RERANK_ENABLED=true
# Reciprocal Rank Fusion constant (Qdrant, Vectorize client, statutory graph leg).
RRF_K=60
# Soft-preference target when the user says "this fiscal year" / "current".
# Leave unset to follow the rate-table year in force today (FY2026-27 as of 2026-07-01).
# CURRENT_FISCAL_YEAR=FY2026-27
# Query-time document / PDF intake (see App/docs/document-processing.md).
# DOCUMENT_MAX_BYTES=41943040
# DOCUMENT_MAX_PDF_XREFS=20000
# DOCUMENT_MAX_PDF_PAGE_EDGE_PT=14400
# DOCUMENT_MAX_IMAGE_PIXELS=20000000
# DOCUMENT_MAX_PDF_RENDER_PIXELS=12000000
# DOCUMENT_OCR_TIMEOUT_SECONDS=20
# DOCUMENT_MAX_ARCHIVE_ENTRIES=1000
# DOCUMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=52428800
# DOCUMENT_MAX_ARCHIVE_COMPRESSION_RATIO=100
# Index-time handbook export uses a higher xref cap; files that fail a
# structural guard are skipped rather than embedded.
# PDF_CORPUS_MAX_XREFS=250000
# OCR sidecar (private network only).
# OCR_SERVICE_MAX_BYTES=12582912
# OCR_SERVICE_MAX_PIXELS=20000000
# OCR_INFERENCE_MAX_CONCURRENT=1

# Snapshot written after a successful index; add `--verify-qdrant` to compare
# the shipped source hash with the serving Qdrant binding sentinel.
# INDEX_FRESHNESS_PATH=App/Model/index_freshness.json
# Local Compose retained snapshots: daily checksum-verified copies, seven
# retained, a monthly disposable restore drill, and a five-minute failure retry.
# QDRANT_SNAPSHOT_DIR=/backups
# QDRANT_SNAPSHOT_KEEP=7
# QDRANT_SNAPSHOT_INTERVAL_SECONDS=86400
# QDRANT_SNAPSHOT_RETRY_SECONDS=300
# QDRANT_RESTORE_DRILL_INTERVAL_SECONDS=2592000
# QDRANT_BACKUP_REQUIRED=true
# Optional Slack incoming webhook (https only). Used with `--notify`.
# FRESHNESS_SLACK_WEBHOOK=
# Write a reindex *request* file on `--enqueue`. Never starts the indexer.
# INDEX_REINDEX_REQUEST_PATH=App/Model/index_reindex_requested.json
# HyDE: registry default off. Leave FLAG_HYDE unset for a percent canary —
# FLAG_HYDE=false forces everyone off; FLAG_HYDE=true forces everyone on.
# FLAG_HYDE=false
FLAG_HYDE_PERCENT=0
HYDE_LLM=false
# English corpus + generate-in-locale. Off = skip the translation retrieval pass.
FLAG_TRANSLATE_RETRIEVE=true
HYDE_MAX_CHARS=480
GROUNDING_THRESHOLD=0.3
# Relevance floor used to decide whether to answer at all when NO cross-encoder
# score is available — the in-image Qdrant sidecar (sparse-only) has no reranker.
# It is the share of the question's IDF-weighted content words present in the best
# passage. Without it, BM25's always-something result over 7,000+ document chunks
# gets served for off-domain questions. Calibrated at 0.50 against the live corpus:
# on-domain scored 0.557-1.000, off-domain 0.000-0.406. Raise it to abstain more
# readily; lower it only with a measurement. See docs/CLOUDFLARE_FALLBACKS.md.
RETRIEVER_LEXICAL_FLOOR=0.50

# -----------------------------------------------------------------------------
# Contradiction grounding (app/entailment.py)
# -----------------------------------------------------------------------------
# Without this the claim checker runs its numeric-only fallback, which catches
# a wrong rate ("VAT is 20%" against an 18% passage) but is blind to semantic
# reversals — "registration is optional" against a passage saying compulsory,
# or "filed annually" against "filed monthly". Both are high-stakes here, so
# the NLI cross-encoder is on by default rather than an unset opt-in.
# Must be a 3-way NLI model whose labels are [contradiction, entailment,
# neutral]; the scorer reads index 0 as contradiction.
ENTAILMENT_MODEL=cross-encoder/nli-deberta-v3-small
# Minimum contradiction probability before a claim is treated as conflicting.
ENTAILMENT_CONTRADICTION_MIN=0.6

# -----------------------------------------------------------------------------
# LLM Configuration
# See docs/MODEL_SWAP_GUIDE.md for tested alternatives.
#
# Default: Sunbird/Sunflower-14B-FP8 — Qwen3-14B architecture, FP8_DYNAMIC
# quantized (compressed-tensors, llmcompressor), natively multilingual across
# 31 Ugandan languages + English (best translation accuracy in 24/31 measured
# pairs per its model card). Weights live at App/Model/Sunflower-14B-FP8/
# (16GB, already downloaded) or Sunbird/Sunflower-14B-FP8 on HuggingFace —
# GATED on HF, the HF_TOKEN account must be granted access at
# https://huggingface.co/Sunbird/Sunflower-14B-FP8 to pull it fresh.
#
# This checkpoint is a vLLM-native artifact, not a plain HF checkpoint —
# LLM_BACKEND=vllm is required (see below); it is not validated against the
# local in-process Transformers+BitsAndBytes path. Measured 2026-08-19 on one
# RTX A6000 + vllm/vllm-openai:v0.8.5: see
# App/docs/traceability/capacity-envelope-2026-08-19.md and
# docs/runbooks/capacity-slo.md for the full numbers.
#
# Local dev bring-up: docker compose -f docker-compose.yml
#   -f App/docker-compose.local-sunflower.yml up -d
#
# Budget:  Qwen3-30B-A3B (MoE, 3B active, 30B quality)
# Simple/no-vLLM fallback: Qwen/Qwen3-8B (Apache-2.0, MMLU 74.7, 128K context)
#   — this is llm.py's own code-level default when LLM_MODEL is unset
#   entirely; it is the one path this project's Luganda/Swahili/Runyankole/
#   Acholi LoRA adapters (fine-tuning/adapters/) actually apply to, since
#   those are only loaded on LLM_BACKEND=local and are shape-bound to the 8B
#   base — see the ADAPTER_BOUND_LOCALES comment in
#   App/backend/app/providers/routing.py. Sunflower does not use them; it is
#   natively trained for these languages instead.
# Legacy:  Qwen/Qwen2.5-3B-Instruct (smaller, 6144 context)
# -----------------------------------------------------------------------------
LLM_MODEL=Sunbird/Sunflower-14B-FP8
LLM_CONTEXT_WINDOW=8192
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_ENABLED=true
LLM_DEVICE=auto
LLM_TORCH_DTYPE=auto

# -----------------------------------------------------------------------------
# LLM Backend (local HF Transformers or vLLM OpenAI-compatible)
# vllm is REQUIRED for the Sunflower default above — see the block it sits
# in. Measured 2026-08-19 on an RTX A6000 (Ampere, no native FP8 tensor
# cores) with Sunflower-14B-FP8: LLM_BACKEND=local does a naive per-layer
# FP8->bf16 dequant (~4.5-5 tok/s); LLM_BACKEND=vllm auto-selects the Marlin
# weight-only-FP8 kernel (~42 tok/s). See docs/MODEL_SWAP_GUIDE.md.
# -----------------------------------------------------------------------------
LLM_BACKEND=vllm
VLLM_BASE_URL=http://localhost:18011/v1
VLLM_API_KEY=not-needed
VLLM_HTTP_TIMEOUT=60

# -----------------------------------------------------------------------------
# Feature Flags (FLAG_* env vars override registry defaults in flags.py)
# -----------------------------------------------------------------------------
FLAG_TOOL_USE=true
FLAG_AGENTIC_MODE=true
# Tool RAG: default off. Leave FLAG_TOOL_RAG unset for a percent canary.
# FLAG_TOOL_RAG=false
# FLAG_TOOL_RAG_PERCENT=0
# TOOL_RAG_TOP_K=5
# TOOL_MAX_CALLS_PER_TURN=8
# TOOL_MAX_CALLS_PER_ITERATION=4
# TOOL_MAX_CALLS_PER_TOOL=3
# MCP remote bind (one env var per namespace). Token is optional bearer.
# MCP_SERVER_URL_TAX_CALCULATOR=https://mcp-tax.internal/rpc
# MCP_SERVER_TOKEN_TAX_CALCULATOR=
# HMAC for MRTR requestState. Required if requestState affects authz.
# MCP_REQUEST_STATE_SECRET=
# Shared idempotency TTL when REDIS_URL is set (seconds).
# MCP_IDEMPOTENCY_TTL_S=86400
# Retrieval serving-path flags (registry defaults: rewrite/cache/corrective/decompose on; hyde off)
# FLAG_QUERY_REWRITE=true
# FLAG_SEMANTIC_CACHE=true
# FLAG_CORRECTIVE_RAG=true
# FLAG_QUERY_DECOMPOSITION=true
# FLAG_TRANSLATE_RETRIEVE=true
# FLAG_HYDE=false
# FLAG_HYDE_PERCENT=0
# FLAG_TICKET_QUEUE=true
# FLAG_WORKFLOWS=true
# FLAG_LANGGRAPH=false

# Upload AV (G13). Production startup requires true. Rejects if clamd is down.
# MALWARE_SCAN_REQUIRED=false
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310

# Isolated parse worker (G13). Production startup requires true.
# DOCUMENT_PARSE_ISOLATED=false
# DOCUMENT_PARSE_TIMEOUT_S=30

# Nightly publication ingest (G15). https only. Never auto-reindexes.
# Production rejects fixture / empty. See docs/PRODUCTION_GATES.md.
# URA_PUBLICATIONS_URL=https://ura.go.ug/en/news

# Account connector. off | mock | live. Unset → mock in development, off in production.
# live also needs URA_ACCOUNT_LIVE_ACK=true and https base. Never invent balances.
# URA_ACCOUNT_API_MODE=mock
# URA_ACCOUNT_API_BASE=
# URA_ACCOUNT_API_TOKEN=
# URA_ACCOUNT_LIVE_ACK=false

# Email/SMS are mock-queued only. Production refuses a live claim.
# NOTIFICATION_LIVE=false

# Operator ack that infra/postgres/rls.sql was applied. Required when
# APP_ENV=production and FLAG_MULTI_TENANT is on.
# MULTI_TENANT_RLS_APPLIED=false

# Prototype sample rows (CMS overrides, inbox, ticket, thumbs-down). Never in production.
# Unset → seed on API start in development. Set false to skip. CLI: python -m app.seed_prototype
# SEED_PROTOTYPE=true
# PROTOTYPE_SEED_PATH=Data/eval/prototype_seed.json

# Staff CMS (G31). Exact-match overrides before retrieval.
# FLAG_ANSWER_OVERRIDES=true

# -- Phase 30: next-generation architecture (all default off) -----------------
# Open in this order; each has a gate to clear first. See
# docs/NEXTGEN_ARCHITECTURE_PROPOSAL_2026.md §7.2.
#
# Locale-specific supervisor patterns. Off, a Luganda query classifies
# against the English tables exactly as before.  Gate: lg golden set >= 90%
# (currently 23/23) and English still 36/36.
# FLAG_MULTILINGUAL_ROUTING=false
#
# Small-model second opinion when rule confidence is low.
# FLAG_SUPERVISOR_LLM_TIEBREAK=false
#
# Per-turn model tier from the route decision. Off, every turn uses
# LLM_MODEL, as before.  Gate: blended cost <= 1.2x baseline.
# FLAG_MODEL_TIERING=false
#
# Deterministic recomputation of money answers; a confirmed mismatch
# escalates.  Gate: numeric error rate down, p95 +<800ms.
# FLAG_EVALUATOR_OPTIMIZER=false
#
# Statutory knowledge graph. `tax_graph` loads it read-only; `graph_fusion`
# lets it reach an answer. Open fusion only if shadow precision >= 75%.
# FLAG_TAX_GRAPH=false
# FLAG_GRAPH_FUSION=false
#
# `tasks` MCP namespace for long-running work.
# FLAG_MCP_TASKS=false

# -- Addressable rollout ------------------------------------------------------
# Any flag can target a share of subjects instead of everyone. Bucketing is
# stable per (flag, subject), so a user stays on one side of the split, and
# widening the percentage never drops someone already inside it.
# A subject the rollout does not target falls through to the flag's DEFAULT,
# not to off — so adding a rollout cannot silently disable a default-on flag.
#
# FLAG_MODEL_TIERING_PERCENT=5           # 0-100, one decimal place
# FLAG_TAX_GRAPH_COHORTS=ura_staff,internal
# FLAG_TAX_GRAPH_ALLOWLIST=tin-1001,tin-1002

# -----------------------------------------------------------------------------
# Model tiers (used when FLAG_MODEL_TIERING=true)
# -----------------------------------------------------------------------------
# T1 stays the dense 8B and is PINNED for the locales below: the lg/sw/nyn/ach
# LoRA adapters are trained against this base, so promoting one of those turns
# to a MoE would drop the adapter and answer worse than the tier it left.
# MODEL_T1=Qwen/Qwen3-8B
# MODEL_T2=Qwen/Qwen3-30B-A3B-Instruct-2507
# MODEL_T3=Qwen/Qwen3-235B-A22B-Instruct-2507
# ADAPTER_BOUND_LOCALES=lg,sw,nyn,ach

# -----------------------------------------------------------------------------
# OpenTelemetry GenAI Observability (opt-in)
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ura-chatbot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# OWASP LLM Guardrails
# -----------------------------------------------------------------------------
MAX_INPUT_LENGTH=2000
ABSTENTION_THRESHOLD=0.15
ESCALATION_THRESHOLD=0.25
INDEX_API_KEY=

# -----------------------------------------------------------------------------
# Privacy & Data Retention
# -----------------------------------------------------------------------------
STORE_RAW_PROMPTS=false
CONVERSATION_TTL_DAYS=7
ANALYTICS_TTL_DAYS=365
FEEDBACK_TTL_DAYS=90
SESSION_TTL_DAYS=30
# Resolved/wontfix tickets are retained for the operational period below;
# open tickets are never deleted by TTL. The idempotent cleanup job runs at
# startup and on this interval in every API replica.
TICKET_TTL_DAYS=90
DOCUMENT_TTL_SECONDS=7200
EPISODIC_TTL_DAYS=90
SEMANTIC_TTL_DAYS=365
RETENTION_CLEANUP_INTERVAL_SECONDS=3600

# Production governance attestations. These are evidence references, not a
# substitute for DPO/legal review; production startup refuses blank values.
# DPIA_APPROVED=false
# DPIA_APPROVAL_REFERENCE=
# PDPO_REGISTRATION_STATUS=confirmed # or not_required, after a DPO decision
# PDPO_REGISTRATION_REFERENCE=

# Required only when any external LLM, translation, ASR/TTS, or hosted vLLM
# processor is configured. Record the approved transfer assessment reference.
# CROSS_BORDER_PROCESSING_APPROVED=false
# CROSS_BORDER_TRANSFER_ASSESSMENT_ID=

# -----------------------------------------------------------------------------
# MLflow Tracking (Optional)
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=ura-chatbot

# -----------------------------------------------------------------------------
# Production Timeouts & Resilience
# -----------------------------------------------------------------------------
LLM_INFERENCE_TIMEOUT=60
QDRANT_TIMEOUT=30
REQUEST_TIMEOUT=120
GRACEFUL_SHUTDOWN_TIMEOUT=10

# -----------------------------------------------------------------------------
# Deployment (Optional)
# SSH key for server deployment
# -----------------------------------------------------------------------------
# DEPLOY_KEY=path/to/ssh/key
# API_HOST=your-server.com

# =============================================================================
# Cloudflare free-tier + Gemini fallbacks  (graceful degradation on Crane Cloud)
# -----------------------------------------------------------------------------
# Master switch. When true, fallbacks fire ONLY if the primary is down or
# over-budget; otherwise behaviour is unchanged. All keys below are read via
# pydantic SecretStr and are never logged. Leave blank to disable a provider.
# =============================================================================
FLAG_CLOUDFLARE_FALLBACK=false

# Per-component selectors (only consulted when FLAG_CLOUDFLARE_FALLBACK=true)
#   DENSE_FALLBACK_BACKEND              -> retrieval fallback when Qdrant is unreachable.
#       unset (default) = AUTO: used whenever CLOUDFLARE_* + VECTORIZE_INDEX are set
#       workers_ai                      = force on (dense bge-m3 + Vectorize, no GPU)
#       none|off|disabled               = force off (degrade straight to keyword)
#     Retrieval always prefers Qdrant (dense + BM25 + rerank); this is tier 2, and
#     the index must be seeded first: python scripts/reindex_vectorize.py --create
#   LLM_FALLBACK_BACKEND=gemini|workers_ai
#   TRANSLATE_FALLBACK_BACKEND=gemini   -> Luganda via Gemini 2.5 Flash
#   STT_FALLBACK_BACKEND=workers_ai     -> Whisper on Workers AI
#   TTS_FALLBACK_BACKEND=workers_ai     -> Deepgram Aura-2 / MeloTTS on Workers AI
#
# STT_/TTS_FALLBACK_BACKEND are the English speech pipeline: Sunbird has no
# English voice, so English otherwise lands on edge-tts for TTS and Sunbird for
# ASR. Both stages are English-only and sit ahead of those in the chain.
#
# Do NOT enable these on the HF Space. Its free tier cannot reach Cloudflare —
# every call dies in the TLS handshake with "SSL: UNEXPECTED_EOF_WHILE_READING"
# (see relay_client.py, which exists for exactly this). The chain then tries
# both TTS models and waits out both timeouts before falling through: measured
# there, uncached English TTS went from ~0.3s to 32.6s. Enable only where
# egress to Cloudflare is confirmed working.
DENSE_FALLBACK_BACKEND=
LLM_FALLBACK_BACKEND=
TRANSLATE_FALLBACK_BACKEND=
STT_FALLBACK_BACKEND=
TTS_FALLBACK_BACKEND=

# Speech models used when the two selectors above are set to workers_ai.
# @cf/openai/whisper (without -turbo) returns 400 on this gateway.
# Aura-2 is first for payload size: ~21 KB of MP3 against MeloTTS's ~288 KB of
# WAV for the same sentence, which dominates on a mobile connection.
STT_FALLBACK_MODEL=@cf/openai/whisper-large-v3-turbo
TTS_FALLBACK_MODEL=@cf/deepgram/aura-2-en
TTS_FALLBACK_MODEL_2=@cf/myshell-ai/melotts

# =============================================================================
# Grounding — what happens to an answer the guards do not trust
# =============================================================================

# Withhold an answer whose figures contradict the URA passage it cites.
#
# Claim verification already catches these (entailment.numeric_contradiction:
# a percentage the cited passage does not state, or — for rule-shaped
# sentences only — an amount it does not state) and the response judge already
# escalates and raises a ticket. What it did not do was stop showing the
# figure, and a taxpayer acts on the number, not on the amber banner above it.
#
# Narrow on purpose: CONTRADICTED claims only, never merely unsupported ones.
# An unsupported claim is one the lexical verifier could not confirm — a
# paraphrase, a synonym, a figure written differently — which happens
# constantly and legitimately.
#
# Set false only to diagnose a suspected false positive; the failure mode of
# leaving it off is a wrong tax figure on a taxpayer's screen.
#
# GROUNDING_THRESHOLD — the faithfulness floor that appends a "verify with URA"
# note rather than withholding — is set with the retrieval flags above.
WITHHOLD_CONTRADICTED_CLAIMS=true

# =============================================================================
# Machine translation — backends and the shared cache (app/mt.py)
# =============================================================================

# Which tier answers first, per direction. `local_first` (default) tries the
# generation model then Sunbird; `local` and `sunbird` pin one tier.
#   RETRIEVAL_MT_BACKEND — the question, translated into English to search the
#     English corpus. A weak translation here costs recall, not correctness.
#   REPLY_MT_BACKEND     — the answer, translated into the taxpayer's language.
#     Kept separate because the quality bar differs: this is the text the
#     taxpayer actually reads.
RETRIEVAL_MT_BACKEND=local_first
REPLY_MT_BACKEND=local_first

# Per-process translation memo. A non-English turn otherwise translates the
# same question twice — the deterministic routers translate it before
# retrieval, and the hybrid retriever translates it again for the corpus — and
# the deterministic replies (greetings, the TIN and return-filing templates,
# the abstention line) are byte-identical every time. This is what makes a
# Luganda turn cost roughly what an English one costs on the second ask.
#
# Entries hold a digest of the text, never the text itself: taxpayer questions
# reach this cache and can carry a TIN or a name. 0 disables it.
MT_CACHE_SIZE=512
MT_CACHE_MAX_CHARS=4000

# =============================================================================
# Speech runtime — warm-up and the phrase cache (app/speech_service.py)
# =============================================================================

# Synthesize one throwaway phrase per locale at startup, on a background
# thread, so the first taxpayer to press Listen does not pay for a cold path.
# The SpeechModel builds its model objects during startup already, but the
# tiers behind them are lazy — the Spark-TTS codec, the edge-tts session, the
# Sunbird client — and without this whoever asks first absorbs all of it.
# The work happens either way; this only decides who waits for it. Set false
# where the extra boot traffic is unwanted (a metered egress, a cold Space).
SPEECH_WARMUP=true
SPEECH_WARMUP_LOCALES=en,lg,sw

# Repeated short phrases (greetings, empathy openers, workflow prompts) skip
# the whole backend chain. Keyed by (text, voice, language). 0 disables.
SPEECH_TTS_CACHE_SIZE=64

# =============================================================================
# Sunbird SALT speech models — local ASR + TTS for Ugandan languages (2026)
# =============================================================================

# Sunbird/asr-whisper-large-v3-salt — one whisper-large-v3 fine-tune covering
# en/lg/sw/nyn/ach (published WER: eng 0.018, lug 0.142). Top ASR tier by
# default: transformers.WhisperForConditionalGeneration, no LoRA merge
# needed. This repo is GATED on HuggingFace — HF_TOKEN (below) must belong to
# an account with granted access, or loading fails and the chain falls
# through to the existing WHISPER_ADAPTER_* / Sherpa / faster-whisper tiers.
# Set WHISPER_SALT_ENABLED=false to opt out (e.g. to avoid the ~6GB pull on a
# constrained deployment).
WHISPER_SALT_ENABLED=true
WHISPER_SALT_MODEL=Sunbird/asr-whisper-large-v3-salt
WHISPER_SALT_DEVICE=

# Sunbird/spark-tts-salt — local neural TTS for lg/sw/ach/nyn, tried FIRST
# (local before API) ahead of Sunbird cloud for those locales; no id is
# published for English, so English requests fall through unchanged. Verified
# end-to-end on a real GPU 2026-08-19 (all four locales produced real,
# non-silent, non-clipped audio) — see docs/runbooks/salt-speech-backends.md
# for the measurements and the two real bugs that verification pass found
# and fixed. ENABLED BY DEFAULT, but that alone does nothing on its own: this
# one needs BiCodec from a *second*, non-pip-installable GitHub repo
# (github.com/SparkAudio/Spark-TTS — no setup.py/pyproject.toml), so it stays
# a no-op — falling through to Sunbird cloud exactly as before this tier
# existed — until SPARK_TTS_REPO_DIR below points at an actual checkout. See
# docs/runbooks/salt-speech-backends.md for the checkout + dependency recipe.
SPARK_TTS_ENABLED=true
SPARK_TTS_MODEL=Sunbird/spark-tts-salt
SPARK_TTS_CODEC_REPO=unsloth/Spark-TTS-0.5B
SPARK_TTS_REPO_DIR=
SPARK_TTS_DEVICE=
# Per-locale speaker id overrides (defaults: lg=248 sw=246 ach=241 nyn=243,
# from the model card's training table — see spark_tts_salt.py for why
# English has no default).
# SPARK_TTS_SPEAKER_LG=248
# SPARK_TTS_SPEAKER_SW=246
# SPARK_TTS_SPEAKER_ACH=241
# SPARK_TTS_SPEAKER_NYN=243

# Cloudflare account + API token — dash.cloudflare.com > My Profile > API Tokens
# Token scopes: Workers AI (Read), Vectorize (Edit), R2 (Edit), AI Gateway (Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare AI Gateway — AI > AI Gateway > create gateway (enable caching + rate-limit)
# CF_AIG_GATEWAY = gateway slug (path segment); CF_AIG_TOKEN = the gateway's auth token
CF_AIG_GATEWAY=
CF_AIG_TOKEN=

# Cloudflare Vectorize — wrangler vectorize create ura-kb-bge-m3 --dimensions 1024 --metric cosine
VECTORIZE_INDEX=ura-kb-bge-m3

# Cloudflare R2 (S3-compatible) — stores bm25_state.json, offline bundles, TTS audio cache
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ura-chatbot

# Google Gemini — key from https://aistudio.google.com/apikey (sent via x-goog-api-key header)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Free-tier guardrails (usage silently degrades to the next tier when exceeded)
CF_NEURON_DAILY_BUDGET=10000
GEMINI_RPM=10

# -----------------------------------------------------------------------------
# Crane Cloud deploy — auto-refresh the access token via email/password login
# (mirrors the CRANE_CLOUD_* GitHub Actions secrets). APP_ID + API are not
# secret; EMAIL/PASSWORD are — keep filled values only in the gitignored .env.
# -----------------------------------------------------------------------------
CRANE_CLOUD_API=https://api.cranecloud.io
CRANE_CLOUD_APP_ID=b01219c6-9555-41e2-84c3-f15d764fb938
CRANE_CLOUD_EMAIL=
CRANE_CLOUD_PASSWORD=

# DNS-over-HTTPS resolver (app/doh_resolver.py). Set true on Crane Cloud / RENU
# where the pod has no working upstream DNS — resolves external hostnames via
# 1.1.1.1 over TCP/443 so the Cloudflare fallback + external LLM work. Leave
# false locally (system DNS is fine). Ported from AgriLinkUganda's workaround.
USE_DOH=false
