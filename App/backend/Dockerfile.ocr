# Local-only OCR sidecar.  The model cache is mounted at /models so the first
# EasyOCR download is retained between compose restarts.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    EASYOCR_MODULE_PATH=/models/easyocr

WORKDIR /service

RUN groupadd --gid 10001 appuser && \
    useradd --uid 10001 --gid appuser --create-home --shell /usr/sbin/nologin appuser

COPY backend/requirements-ocr.txt /tmp/requirements-ocr.txt
RUN pip install --no-cache-dir -r /tmp/requirements-ocr.txt

COPY backend/app /service/app
RUN mkdir -p /models && chown -R appuser:appuser /service /models

USER appuser

EXPOSE 8100

CMD ["uvicorn", "app.ocr_service:app", "--host", "0.0.0.0", "--port", "8100", "--workers", "1"]
