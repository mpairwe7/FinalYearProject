# Copy to .env.production and fill with real production values.
# Do not commit populated secrets.

WORKERS=2
LOG_LEVEL=info
CORS_ORIGINS=https://chat.ura.go.ug

AUTH_ALG=RS256
AUTH_DEV_SECRET=EXAMPLE_ONLY_AUTH_DEV_SECRET
OIDC_ISSUER=https://idp.example.gov/realms/ura
OIDC_AUDIENCE=ura-chatbot
OIDC_JWKS_URL=https://idp.example.gov/realms/ura/protocol/openid-connect/certs

POSTGRES_DSN=postgresql://ura_app@postgres.example.gov:5432/ura_chatbot
REDIS_AUTH=EXAMPLE_ONLY_REDIS_AUTH
QDRANT_API_KEY=EXAMPLE_ONLY_QDRANT_API_KEY
INDEX_API_KEY=EXAMPLE_ONLY_INDEX_API_KEY

REQUIRE_FRESH_AUTHORITY=true
URA_AUTHORITY_MANIFEST=/app/artifacts/authority/manifest.json
URA_ACCOUNT_API_BASE=https://api.ura.go.ug/account
URA_ACCOUNT_API_TOKEN=EXAMPLE_ONLY_URA_ACCOUNT_TOKEN
URA_ACTION_API_BASE=https://api.ura.go.ug/actions
URA_ACTION_API_TOKEN=EXAMPLE_ONLY_URA_ACTION_TOKEN

LLM_MODEL_REVISION=0000000000000000000000000000000000000000
HF_HUB_OFFLINE=1

FLAG_AGENTIC_MODE=true
FLAG_TOOL_USE=true
FLAG_TICKET_QUEUE=true
FLAG_MEMORY_ENABLED=true
FLAG_HANDOFF_SUMMARIES=true
FLAG_WORKFLOWS=true

# Privacy governance deployment attestations — use approved evidence IDs, never
# personal names or documents in environment variables.
DPIA_APPROVED=true
DPIA_APPROVAL_REFERENCE=DPIA-CHANGE-ME
PDPO_REGISTRATION_STATUS=confirmed
PDPO_REGISTRATION_REFERENCE=PDPO-CHANGE-ME

# Set these only when an approved external processor is enabled.
CROSS_BORDER_PROCESSING_APPROVED=false
CROSS_BORDER_TRANSFER_ASSESSMENT_ID=
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
