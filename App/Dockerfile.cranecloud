# syntax=docker/dockerfile:1.7
#
# URA Chatbot — Crane Cloud single-container image.
#
# Crane Cloud has two constraints that shape this Dockerfile:
#   1. One service per app, one public port.  We bundle nginx + FastAPI
#      + Next.js together and front them with supervisord.
#   2. No persistent volumes.  The BM25 keyword index and the FAQ CSV
#      corpus are baked into the image at build time.
#
# CPU profile: torch / transformers / sentence-transformers are
# excluded (no GPU on Crane Cloud).  The app's LLM dispatches through
# an external endpoint (LLM_BACKEND=vllm pointing at VLLM_BASE_URL).
# Retrieval falls back to keyword search; QDRANT_ENABLED=false is the
# default operating mode on Crane Cloud.
#
# Build:
#   docker build -t landwind/ura-chatbot:cranecloud -f App/Dockerfile.cranecloud .
#
# Run locally:
#   docker run --rm -p 8080:8080 \
#     -e LLM_BACKEND=vllm \
#     -e VLLM_BASE_URL=https://your-vllm-endpoint/v1 \
#     -e CORS_ORIGINS=https://your-public-url \
#     landwind/ura-chatbot:cranecloud

# =============================================================================
# Stage 1 — Python backend deps (slim, CPU-only)
# =============================================================================
FROM python:3.11-slim-bookworm AS backend-builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install slim Crane Cloud profile (no torch / transformers / etc.)
COPY App/backend/requirements-cranecloud.txt ./requirements-cranecloud.txt
RUN pip install --upgrade pip wheel setuptools && \
    pip install -r requirements-cranecloud.txt && \
    # Aggressive prune to keep image small.
    #
    # dist-info directories are deliberately KEPT. Deleting them saves a few MB
    # of an 800 MB image and breaks importlib.metadata for any package that
    # reads its own version at runtime — qdrant-client does exactly that in
    # QdrantRemote.__init__, so `QdrantClient(url=...)` raised
    # PackageNotFoundError and every Qdrant connection failed before it opened a
    # socket. HybridRetriever swallowed it as "Qdrant init failed" and dropped to
    # the keyword fallback, which is part of why these deployments looked like
    # they simply had no Qdrant to reach.
    find /opt/venv -type d -name "__pycache__" -prune -exec rm -rf {} + && \
    find /opt/venv -type d -name "tests" -prune -exec rm -rf {} + && \
    find /opt/venv -type d -name "test" -prune -exec rm -rf {} +

# =============================================================================
# Stage 2 — Frontend (Next.js standalone build)
# =============================================================================
FROM node:20-bookworm-slim AS frontend-builder

WORKDIR /build/frontend

# Install bun (matches local dev tooling per CLAUDE.md).
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://bun.sh/install | bash \
    && ln -sf /root/.bun/bin/bun /usr/local/bin/bun

COPY App/frontend/package.json App/frontend/bun.lockb* App/frontend/package-lock.json* ./
RUN if [ -f bun.lockb ]; then bun install --frozen-lockfile; \
    else npm install --no-audit --no-fund; fi

COPY App/frontend/ ./
# next.config sets `output: "standalone"` per the live-smoke note; that
# emits .next/standalone/server.js + .next/static/.
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run build || npm run build

# =============================================================================
# Stage 3 — Runtime (nginx + supervisord + uvicorn + node)
# =============================================================================
FROM python:3.11-slim-bookworm AS runtime

LABEL org.opencontainers.image.title="URA Chatbot (Crane Cloud)" \
      org.opencontainers.image.description="Single-container CPU image for Crane Cloud RENU cluster" \
      org.opencontainers.image.source="https://github.com/mpairweLandwind/FinalYearProject"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:/usr/local/bin:/usr/bin:/bin" \
    APP_ENV=production \
    LOG_LEVEL=info \
    UVICORN_WORKERS=2 \
    QDRANT_ENABLED=false \
    SPEECH_ENABLED=false \
    LLM_BACKEND=vllm

# System dependencies: nginx, supervisord, node (for Next.js standalone),
# plus libgomp1 which sentence-transformers wheel sometimes links against
# (we exclude the package, but a few transitive deps do touch libgomp).
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
        ca-certificates \
        curl \
        fonts-dejavu-core \
        libgomp1 \
        # The Qdrant sidecar binary links libunwind-ptrace.so.0; without this it
        # fails to start with "error while loading shared libraries" and the
        # baked-collection build step times out waiting on /healthz.
        libunwind8 \
        tini \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/dpkg.log

# Bring in the slim Python venv from stage 1.
COPY --from=backend-builder /opt/venv /opt/venv

# Backend source.
WORKDIR /app
COPY App/backend/app /app/backend/app
COPY App/backend/pyproject.toml* /app/backend/

# Bake in the BM25 keyword index + every corpus.  Crane Cloud and the HF Space
# have no persistent storage and cannot reach Qdrant, so whatever retrieval can
# see at runtime is exactly what ships here.
COPY Model/bm25_state.json /app/Model/bm25_state.json
COPY Data/dataset /app/Data/dataset
# Validated JSONL corpora. APP_DATA_ROOT resolves to /app/Data in the container
# (no /app/App directory), so these land where the ingesters look for them.
# The chunk corpora are generated — build with `python -m app.indexer
# --export-faq-jsonl --export-pdf-jsonl --export-crawl-jsonl` before the image
# build, or these COPYs fail loudly rather than shipping a half corpus.
COPY App/Data/faq_jsonl   /app/Data/faq_jsonl
COPY App/Data/teacher_qa  /app/Data/teacher_qa
COPY App/Data/pdf_jsonl   /app/Data/pdf_jsonl
COPY App/Data/crawl_jsonl /app/Data/crawl_jsonl

# Frontend: copy the Next.js standalone output ONLY.
COPY --from=frontend-builder /build/frontend/.next/standalone /app/frontend
COPY --from=frontend-builder /build/frontend/.next/static    /app/frontend/.next/static
COPY --from=frontend-builder /build/frontend/public          /app/frontend/public

# --- Qdrant sidecar ---------------------------------------------------------
# Neither a managed Qdrant nor Cloudflare is reachable from Crane Cloud or the HF
# Space, which left retrieval on the FAQ-only keyword fallback — it never saw a
# PDF or crawl chunk. Running Qdrant in-container puts the whole corpus back
# behind the retriever.
#
# The collection is SPARSE-ONLY and is built here, at image build time, so the
# image is self-contained and no runtime indexing step is needed. Sparse-only is
# not a compromise for this image: a BM25 query vector is computed from
# bm25_state.json in pure Python, whereas a dense query would need bge-m3 and
# this image deliberately ships no torch, so dense vectors would be unqueryable.
COPY --from=qdrant/qdrant:v1.15.1 /qdrant/qdrant /usr/local/bin/qdrant

RUN set -eux; \
    mkdir -p /app/qdrant/storage; \
    cd /app/qdrant; \
    QDRANT__STORAGE__STORAGE_PATH=/app/qdrant/storage \
    QDRANT__SERVICE__HTTP_PORT=6333 \
    QDRANT__TELEMETRY_DISABLED=true \
    /usr/local/bin/qdrant & \
    QDRANT_PID=$!; \
    for _ in $(seq 1 90); do \
        if curl -sf http://127.0.0.1:6333/healthz >/dev/null 2>&1; then break; fi; \
        sleep 1; \
    done; \
    if ! curl -sf http://127.0.0.1:6333/healthz >/dev/null; then \
        echo "qdrant did not become healthy; it usually failed to exec — check shared libs:" >&2; \
        /usr/local/bin/qdrant --version >&2 || true; \
        exit 1; \
    fi; \
    cd /app/backend; \
    SPARSE_ONLY_INDEX=true \
    QDRANT_URL=http://127.0.0.1:6333 \
    APP_DATA_ROOT=/app/Data \
    # The image ships the derived JSONL but not the 500 MB of source PDFs or the
    # crawl pages, so ingest cannot re-hash them. Everything internal to the
    # export is still verified; only the source-hash comparison is skipped.
    CORPUS_TRUST_MANIFEST=true \
    PYTHONPATH=. \
    /opt/venv/bin/python -m app.indexer --recreate; \
    # bm25_state.json is rewritten by the index build so the sparse vectors and
    # the vocab/idf come from the same fit — the corpus-hash sentinel would
    # otherwise disable sparse retrieval at startup.
    test -s /app/Model/bm25_state.json; \
    # procps is not installed, so stop it by the PID captured above.
    kill "$QDRANT_PID"; \
    wait "$QDRANT_PID" || true; \
    du -sh /app/qdrant/storage

# Readiness gate: uvicorn waits for the sidecar's /healthz before starting, so the
# retriever does not initialise into a keyword-only fallback and serve FAQ-only
# answers until something triggers a re-init.
COPY App/deploy/cranecloud/wait-for-qdrant.sh /usr/local/bin/wait-for-qdrant.sh
RUN chmod +x /usr/local/bin/wait-for-qdrant.sh && sh -n /usr/local/bin/wait-for-qdrant.sh

# Process supervision + reverse proxy.
COPY App/deploy/cranecloud/nginx.conf       /etc/nginx/nginx.conf
COPY App/deploy/cranecloud/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-available/default

# Crane Cloud expects port 8080.
EXPOSE 8080

# Default operational env — overridable by the Crane Cloud env panel.
ENV BM25_STATE_PATH=/app/Model/bm25_state.json \
    DATA_DIR=/app/Data/dataset \
    APP_DATA_ROOT=/app/Data \
    # Point the retriever at the in-container sidecar holding the baked
    # sparse-only collection. It detects sparse-only from the collection itself,
    # so no extra flag is needed here.
    QDRANT_ENABLED=true \
    QDRANT_URL=http://127.0.0.1:6333 \
    QDRANT_COLLECTION=ura_knowledge_base \
    # Tells the production env check that this loopback URL is the intentional
    # in-image sidecar, not a misconfiguration. Without it the backend refuses to
    # start in production.
    QDRANT_SIDECAR=true \
    FLAG_WS_CHAT=false \
    FLAG_TOOL_USE=false \
    FLAG_AGENTIC_MODE=false \
    FLAG_AUTH_REQUIRED=false \
    AUTH_ALG=HS256

# tini reaps zombies cleanly under supervisord.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
