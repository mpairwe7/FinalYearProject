{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run next dev",
    "build": "bun run next build && ln -sfn ../../static .next/standalone/.next/static && ln -sfn ../public .next/standalone/public",
    "start": "bun run next start",
    "preflight:deploy": "bash ../scripts/deploy_preflight.sh",
    "smoke:live": "bash ../scripts/live_smoke.sh",
    "lint": "bun run eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=a11y"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "dompurify": "^3.4.2",
    "mermaid": "^11.17.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "@axe-core/playwright": "^4.13.0",
    "eslint": "9.26.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
