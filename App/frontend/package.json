{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run next dev",
    "build": "bun run next build",
    "start": "bun run next start",
    "preflight:deploy": "bash ../scripts/deploy_preflight.sh",
    "smoke:live": "bash ../scripts/live_smoke.sh",
    "lint": "bun run eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=a11y"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.0",
    "mermaid": "^11.14.0",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.7",
    "recharts": "^3.8.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.5",
    "axe-core": "^4.10.3",
    "@axe-core/playwright": "^4.10.3",
    "eslint": "9.26.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  }
}
