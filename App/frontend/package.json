{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bun run next dev",
    "build": "bun run next build && ln -sfn ../../static .next/standalone/.next/static && ln -sfn ../../public .next/standalone/public",
    "start": "bun run next start",
    "preflight:deploy": "bash ../scripts/deploy_preflight.sh",
    "smoke:live": "bash ../scripts/live_smoke.sh",
    "lint": "bun run eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=a11y"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "dompurify": "^3.4.17",
    "livekit-client": "^2.22.4",
    "mermaid": "^11.17.2",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "web-vitals": "6.2.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.14.0",
    "@axe-core/playwright": "^4.14.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.4.1",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "ip-address": "^10.7.3",
    "fast-uri": "^4.2.1",
    "katex": "^0.18.2"
  },
  "resolutions": {
    "ip-address": "^10.7.3",
    "fast-uri": "^4.2.1",
    "katex": "^0.18.2"
  }
}
