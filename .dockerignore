# Python
__pycache__
*.pyc
*.pyo
*.pyd
*.db
*.sqlite

# Environment. A pattern here is anchored at the context root, and the working file is
# App/.env: `.env` alone left it inside every build context that starts at the repository root.
**/.env
**/.env.*
*.log

# IDEs
.idea/
.vscode/

# Git
.git/
.gitignore

# Node.js
node_modules/
dist/
build/
.next/

# Project specific
artifacts/
App/Model/
App/Results/
App/Data/pdfs/
App/Data/lgaudio/
App/Data/TTT/
# Generated eval audio (receptionist language id, Orpheus samples, call replay)
evals/language_id/data/
evals/orpheus_tts/samples/
evals/call_replay/audio/

# OS
.DS_Store

# App folders to exclude (use specific COPY in App/Dockerfile)
App/frontend/node_modules/
App/frontend/.next/
App/backend/__pycache__/

# Documentation
App/docs/
*.md
!README.md
